# =============================================================================
# @file Dockerfile.uxrce-agent
# @brief uXRCE-DDS Agent 多階段 Docker 建構檔案
# @author Taiphoon Agent Team
# @date 2026-07-27
#
# Stage 階層架構:
#   builder   編譯 MicroXRCEAgent (從原始碼，含 superbuild Fast-DDS)
#   runtime   精簡執行環境 (ROS2 Humble base + 所有編譯產物)
# =============================================================================

FROM ros:humble-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libssl-dev \
    ros-humble-foonathan-memory-vendor \
    && rm -rf /var/lib/apt/lists/*

# ---- 克隆並編譯 Micro-XRCE-DDS-Agent (含 superbuild) ----
RUN git clone --depth 1 --branch v2.4.3 \
    https://github.com/eProsima/Micro-XRCE-DDS-Agent.git \
    /tmp/Micro-XRCE-DDS-Agent \
    && mkdir -p /tmp/Micro-XRCE-DDS-Agent/build \
    && cd /tmp/Micro-XRCE-DDS-Agent/build \
    && /bin/bash -c "source /opt/ros/humble/setup.bash && cmake .. \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_PREFIX_PATH=/opt/ros/humble \
        -Dfoonathan_memory_DIR=/opt/ros/humble/lib/foonathan_memory/cmake" \
    && make -j$(nproc) \
    && make install

# ---- 將 superbuild 的 Fast-DDS/fastcdr lib 也安裝到 /usr/local ----
RUN cd /tmp/Micro-XRCE-DDS-Agent/build \
    && find temp_install -name 'libfast*.so*' -exec cp -a {} /usr/local/lib/ \; 2>/dev/null || true \
    && ldconfig

# =============================================================================
# Stage 2: 精簡執行環境
# =============================================================================
FROM ros:humble-ros-base AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-rmw-fastrtps-cpp \
    ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# ---- 從 builder 複製所有編譯產物 ----
COPY --from=builder /usr/local/bin/MicroXRCEAgent /usr/local/bin/MicroXRCEAgent
COPY --from=builder /usr/local/lib/ /usr/local/lib/

RUN ldconfig

RUN useradd -m -s /bin/bash taiphoon \
    && echo "taiphoon ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER taiphoon
WORKDIR /home/taiphoon

RUN echo "source /opt/ros/humble/setup.bash" >> /home/taiphoon/.bashrc \
    && echo "export RMW_IMPLEMENTATION=\${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}" >> /home/taiphoon/.bashrc

ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

ENTRYPOINT ["MicroXRCEAgent"]
CMD ["udp4", "-p", "8888"]
